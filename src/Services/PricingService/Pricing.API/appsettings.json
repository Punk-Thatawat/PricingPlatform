{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RuleService": {
    "BaseUrl": "",
    "ActiveRulesPath": "/rules?isActive=true",
    "CacheTtlSeconds": 300
  },
  "HttpRetry": {
    "MaxRetries": 3,
    "BaseDelayMilliseconds": 200
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 20
  },
  "BulkQuoteStorage": {
    "RootPath": "",
    "UploadDirectoryName": "uploads",
    "ResultDirectoryName": "results"
  },
  "AllowedHosts": "*"
}
